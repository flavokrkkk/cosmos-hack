COSMOS_APP_NAME=Cosmos Hack API
COSMOS_DEBUG=true
COSMOS_CORS_ALLOWED_ORIGINS=http://localhost:5173

COSMOS_DB_NAME=cosmos_hack
COSMOS_DB_USER=cosmos_hack
COSMOS_DB_PASS=cosmos_hack
COSMOS_DB_HOST=localhost
COSMOS_DB_PORT=5432

COSMOS_JWT_SECRET_KEY=replace-with-a-long-random-secret
COSMOS_JWT_ALGORITHM=HS256
COSMOS_ACCESS_TOKEN_EXPIRE_MINUTES=30
COSMOS_REFRESH_TOKEN_EXPIRE_DAYS=7

COSMOS_BOOTSTRAP_ADMIN_USERNAME=admin
COSMOS_BOOTSTRAP_ADMIN_PASSWORD=change-me-now

COSMOS_REDIS_URL=redis://localhost:6379/0
COSMOS_OLLAMA_BASE_URL=http://localhost:11434
COSMOS_OLLAMA_MODEL=qwen3:4b
COSMOS_OLLAMA_TIMEOUT_SECONDS=180
COSMOS_OLLAMA_USERNAME=
COSMOS_OLLAMA_PASSWORD=
