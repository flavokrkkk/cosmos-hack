# Скопируйте в .env и при необходимости поменяйте значения.
# Файл .env в репозиторий не коммитится.

# --- Секреты приложения ---
COSMOS_JWT_SECRET_KEY=local-development-secret-at-least-32-bytes
COSMOS_BOOTSTRAP_ADMIN_USERNAME=admin
COSMOS_BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# --- LLM ---
COSMOS_OLLAMA_MODEL=qwen3:4b
COSMOS_OLLAMA_TIMEOUT_SECONDS=180

# --- Порты на хосте (меняйте, если заняты другими проектами) ---
COSMOS_DB_HOST_PORT=5432
COSMOS_REDIS_HOST_PORT=6379
COSMOS_API_HOST_PORT=8000
COSMOS_WEB_HOST_PORT=5173
COSMOS_OLLAMA_HOST_PORT=11434

# --- CORS бэкенда (через запятую) ---
COSMOS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Frontend ---
VITE_API_URL=/api

# --- Публичный туннель (только для профиля tunnel) ---
# docker compose --profile tunnel up -d tuna
TUNA_DOMAIN=
TUNA_TOKEN=
TUNA_LOCATION=nl
