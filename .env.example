# Настройки демо команды для docker-compose.team.yml. Для жюри .env не нужен.
# Файл .env в репозиторий не коммитится.

# --- LLM ---
COSMOS_OLLAMA_ENABLED=true
COSMOS_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Для Ollama в контейнере используйте scripts/run_local.py --ollama on.
COSMOS_OLLAMA_IMAGE=ollama/ollama:0.32.15
COSMOS_OLLAMA_MODEL=qwen3:4b-instruct
COSMOS_OLLAMA_TIMEOUT_SECONDS=45
COSMOS_OLLAMA_PARALLEL_REQUESTS=2

# --- Порты на хосте (меняйте, если заняты другими проектами) ---
COSMOS_API_HOST_PORT=8000
COSMOS_WEB_HOST_PORT=5173
COSMOS_OLLAMA_HOST_PORT=11435

# --- CORS бэкенда (через запятую) ---
COSMOS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Публичный туннель (только для профиля tunnel) ---
# После запуска приложения: docker compose -f docker-compose.yml -f docker-compose.team.yml --profile tunnel up -d --no-deps tuna
TUNA_DOMAIN=
TUNA_TOKEN=
TUNA_LOCATION=nl
